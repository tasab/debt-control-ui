# Клієнт і API під одним origin.
#
# SPA ходить в /api відносним шляхом (lib/api/client.ts), а кука сесії має
# sameSite=lax — тобто на чужий домен браузер її не віддасть. Якби клієнт
# стукав напряму в публічний домен сервера, вхід просто не тримався б, і
# лікувалося б це переходом на sameSite=none, тобто зняттям єдиного захисту
# від CSRF, який у цьому додатку є.
#
# Тому /api проксюється на сервер приватною мережею Railway: браузер бачить
# один домен, кука лишається lax, CORS не потрібен узагалі, а трафік між
# сервісами не виходить назовні й не тарифікується.
:{$PORT:8080}

encode zstd gzip

handle /api/* {
	reverse_proxy {$API_UPSTREAM}
}

handle {
	root * /app/dist
	# Будь-який глибокий шлях (/share/<token>, /history/<id>) віддає index.html —
	# далі маршрут розбирає React Router уже в браузері.
	try_files {path} /index.html
	file_server
}
